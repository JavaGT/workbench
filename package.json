{
	"name": "workbench",
	"version": "0.1.3",
	"description": "Workbench for collaborative, persisted, realtime data.",
	"type": "module",
	"sideEffects": [
		"./build/annotated-text-field.mjs",
		"./src/annotated-text-field.ts"
	],
	"files": [
		"build/",
		"public/",
		"index.d.ts",
		"client.d.ts",
		"annotated-text.d.ts",
		"annotated-text-coords.d.ts",
		"annotated-text-authoring.d.ts",
		"src/server.d.ts",
		"README.md",
		"CHANGELOG.md"
	],
	"main": "build/index.mjs",
	"types": "index.d.ts",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./build/index.mjs"
		},
		"./client": {
			"types": "./client.d.ts",
			"default": "./public/workbench-client.mjs"
		},
		"./server": {
			"types": "./src/server.d.ts",
			"default": "./build/server.mjs"
		},
		"./annotated-text": {
			"types": "./annotated-text.d.ts",
			"default": "./build/annotated-text-public.mjs"
		},
		"./annotated-text-coords": {
			"types": "./annotated-text-coords.d.ts",
			"default": "./public/workbench-annotated-text-coords.mjs"
		},
		"./annotated-text-authoring": {
			"types": "./annotated-text-authoring.d.ts",
			"default": "./build/annotated-text-authoring-public.mjs"
		}
	},
	"scripts": {
		"lanes": "node scripts/lane.mjs",
		"check:heavy": "node scripts/heavy-command.mjs",
		"emit:ts": "node --disable-warning=ExperimentalWarning scripts/emit-ts.mjs",
		"build": "pnpm emit:ts",
		"setup:hooks": "sh scripts/setup-hooks.sh",
		"lint": "eslint --max-warnings 0 .",
		"test": "pnpm emit:ts && node scripts/run-tests.mjs",
		"test:bun": "bun test test/w8-bun-ws-streaming.test.mjs test/w7-bun-cutover-parity.test.mjs",
		"bench": "node bench/hot-path.mjs",
		"bench:quick": "node bench/hot-path.mjs --sizes small --samples 3",
		"bench:compile": "node bench/hot-path.mjs --benchmarks compile",
		"bench:http": "node bench/hot-path.mjs --benchmarks http-crud",
		"bench:commit": "node bench/hot-path.mjs --benchmarks commit",
		"bench:live": "node bench/hot-path.mjs --benchmarks live-delivery",
		"bench:live-delivery": "node bench/live-delivery.mjs",
		"bench:text": "node bench/hot-path.mjs --benchmarks annotated-text",
		"bench:profile": "node bench/hot-path.mjs --profile bench/workbench-performance.cpuprofile",
		"bench:compare": "node bench/hot-path.mjs --compare bench/baseline.json",
		"test:playwright": "playwright test",
		"test:coverage": "node scripts/check-coverage.mjs 0",
		"typecheck": "tsc --noEmit",
		"typecheck:browser": "tsc -p tsconfig.browser.json --noEmit",
		"check:annotated-text-single-authority": "node scripts/check-annotated-text-single-authority.mjs",
		"check:architecture-map": "node scripts/check-architecture-map.mjs",
		"check:dep-graph": "node scripts/check-dep-graph.mjs",
		"check:file-sizes": "node scripts/check-file-sizes.mjs",
		"check:dts-parity": "node scripts/check-dts-parity.mjs",
		"test:deletion:annotated-text-composition": "node scripts/deletion-test-annotated-text-composition.mjs",
		"benchmark:annotated-text-composite-resync": "node benchmark/annotated-text-composite-resync.mjs",
		"benchmark:annotated-text-composite-resync:acceptance": "node benchmark/annotated-text-composite-resync-runner.mjs",
		"verify:concise": "pnpm lint && pnpm typecheck && pnpm typecheck:browser && pnpm check:annotated-text-single-authority && pnpm check:architecture-map && pnpm check:dep-graph && pnpm check:file-sizes && pnpm check:dts-parity && pnpm test"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@types/node": "^26.1.1",
		"@types/ws": "^8.18.2",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.7.0",
		"idb": "^8.0.4",
		"jsdom": "^29.1.1",
		"typescript": "^7.0.2",
		"xstate": "6.0.0-beta.5"
	},
	"engines": {
		"node": ">=24.10.0"
	},
	"dependencies": {
		"@mjackson/multipart-parser": "^0.10.1",
		"cookie": "^2.0.2",
		"lru-cache": "^11.5.3",
		"msgpackr": "^2.1.4",
		"rou3": "^1.0.0",
		"ws": "^8.23.0"
	}
}
