{
  "//": "Staged browser typechecking with checkJs on the public leaves owned by this lane. noResolve keeps the check on the leaves themselves: the re-export shims point at emitted build/ modules and another lane's editor, which are checked in their own lanes. public/workbench-client.mjs (the large façade) stays out of scope.",
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noImplicitAny": false,
    "noEmit": true,
    "noResolve": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "public/workbench-annotated-text-action.mjs",
    "public/workbench-annotated-text-coords.mjs",
    "public/workbench-annotated-text-redaction-coords.mjs",
    "public/workbench-annotated-text-snapshot-internal.mjs",
    "public/workbench-annotated-text.mjs",
    "public/workbench-local-log.mjs",
    "public/workbench-ui-bindings.mjs"
  ],
  "exclude": ["node_modules", "build", "src", "test", "projects"]
}
